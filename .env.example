# Copy to .env.deploy (git-ignored) and fill in your server. See docs/development.md#deploy.
DEPLOY_HOST=user@203.0.113.10
DEPLOY_PORT=22
DEPLOY_KEY=~/.ssh/id_ed25519
DEPLOY_DIR=/srv/seekin/app
DEPLOY_VENV=/srv/seekin/venv
DEPLOY_CACHE=/srv/seekin/cache
# Restart this systemd unit after deploying; leave unset to run uvicorn in tmux instead.
DEPLOY_SERVICE=seekin-api
# URL of the API, used by the web dev server proxy
API_URL=https://seekin.space
